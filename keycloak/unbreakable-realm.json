      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_SEED_USER_PASSWORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "realmRoles": [
        "default-roles-unbreakable"
      ]
    },
    {
      "id": "2dac8c5a-7b4e-4e3a-9c73-5f8b3a4c9e03",
      "username": "chris",
      "enabled": true,
      "firstName": "Chris",
      "lastName": "Test",
      "email": "chris@unbreakable.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_SEED_USER_PASSWORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "realmRoles": [
        "default-roles-unbreakable"
      ]
    }
  ]
}
